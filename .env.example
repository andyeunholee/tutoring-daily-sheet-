# 이 파일의 이름을 .env 로 변경하고 정보를 입력하세요.
# Gmail을 사용하는 경우, 2단계 인증을 켜고 "앱 비밀번호"를 생성하여 PASSWORD에 입력해야 합니다.

SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
RECEIVER_EMAIL=andy.lee@eliteprep.com

# --- 검토·발송 앱 (review_app.py) ---
# 학생/학부모 이메일 명부 Google Sheet의 ID.
# 시트 주소가 https://docs.google.com/spreadsheets/d/AAA111.../edit 이면 AAA111... 부분.
# 시트 안에 "Students" 라는 이름의 탭이 있어야 합니다.
STUDENTS_SPREADSHEET_ID=
